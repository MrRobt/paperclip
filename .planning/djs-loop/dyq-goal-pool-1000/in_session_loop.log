+#!/usr/bin/env bash
+# C1/P1：DYQ 主后端 48080 与 PokeClaw 设备端接口最小运行态冒烟。
+# 凭证从环境变量读取，禁止在日志中输出明文密码或完整令牌。
+
+set -euo pipefail
+
+BASE_URL="${DYQ_BASE_URL:-http://127.0.0.1:48080}"
+OUT_DIR="${1:-.planning/audit/runs/$(date +%Y%m%d-%H%M%S)-claw-48080-smoke}"
+RESP_DIR="$OUT_DIR/responses"
+RUN_LOG="$OUT_DIR/run.log"
+DEVICE_ID="${CLAW_SMOKE_DEVICE_ID:-pokeclaw-smoke-$(date +%s)}"
+TENANT_ID_HEADER="${DYQ_TENANT_ID:-}"
+
+mkdir -p "$RESP_DIR"
+
+log() {
+  printf '%s\n' "$*" | tee -a "$RUN_LOG"
+}
+
+http_json() {
+  local name="$1"
+  local method="$2"
+  local path="$3"
+  local body="${4:-}"
+  local token="${5:-}"
+  local resp_file="$RESP_DIR/${name}.json"
+  local code_file="$RESP_DIR/${name}.code"
+  local args=(-sS -o "$resp_file" -w "%{http_code}" -X "$method" "$BASE_URL$path" -H "Content-Type: application/json")
+  if [[ -n "$TENANT_ID_HEADER" ]]; then
+    args+=(-H "tenant-id: $TENANT_ID_HEADER")
+  fi
+  if [[ -n "$token" ]]; then
+    args+=(-H "Authorization: Bearer $token")
+  fi
+  if [[ -n "$body" ]]; then
+    args+=(-d "$body")
+  fi
+  if curl "${args[@]}" > "$code_file" 2>"$RESP_DIR/${name}.err"; then
+    :
+  else
+    printf '000' > "$code_file"
+  fi
+  log "[HTTP] $name $(cat "$code_file") $path"
+}
+
+json_get() {
+  local file="$1"
+  local expr="$2"
+  python3 - "$file" "$expr" <<'PY'
+import json, sys
+try:
+    obj = json.load(open(sys.argv[1], encoding='utf-8'))
+except Exception:
+    print('')
+    raise SystemExit(0)
+cur = obj
+for part in sys.argv[2].split('.'):
+    if isinstance(cur, dict):
+        cur = cur.get(part)
+    else:
+        cur = None
+    if cur is None:
+        break
+print('' if cur is None else cur)
+PY
+}
+
+assert_code_in() {
+  local name="$1"
+  local allowed="$2"
+  local actual
+  actual="$(cat "$RESP_DIR/${name}.code")"
+  if [[ ",$allowed," == *",$actual,"* ]]; then
+    log "[PASS] $name HTTP=$actual"
+  else
+    log "[FAIL] $name HTTP=$actual 期望={$allowed}"
+    return 1
+  fi
