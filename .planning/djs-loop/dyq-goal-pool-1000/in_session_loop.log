+def create_wechat_event_report_result(task_id: str, listener_event: Dict[str, Any]) -> Dict[str, Any]:
+    """把本地微信监听事件封装为可回传 DYQ 云端的只读事件结果。
+
+    安全原则：事件上报只做云端感知与后续 AI 分析，不触发任何微信发送动作。
+    当前复用已验证的设备任务 result 回传通道，避免新增后端架构或表结构。
+    """
+    messages = listener_event.get('messages') or []
+    latest_message = str(messages[-1]) if messages else None
+    request_id = _first_present(
+        listener_event.get('request_id'),
+        listener_event.get('requestId'),
+        listener_event.get('event_id'),
+        f"weflow-event-{int(time.time())}",
+    )
+    return {
+        'success': True,
+        'status': 'reported',
+        'taskId': task_id,
+        'requestId': request_id,
+        'eventType': 'wechat.message.receive',
+        'event': {
