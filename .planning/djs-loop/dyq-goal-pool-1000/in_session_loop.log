+        pending_task.get('taskUuid'),
+        pending_task.get('uuid'),
+        f"weflow-draft-{int(time.time())}",
+    )
+    session_name = _first_present(
+        payload.get('sessionName'),
+        payload.get('target'),
+        payload.get('contactName'),
+        '文件传输助手',
+    )
+    text = _first_present(
+        payload.get('text'),
+        payload.get('content'),
+        payload.get('message'),
+        '',
+    )
