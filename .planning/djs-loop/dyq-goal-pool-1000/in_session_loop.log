+def extract_first_pending_task(response_body: Dict[str, Any]) -> Dict[str, Any]:
+    """从DYQ pending-tasks 响应中抽取第一条待执行任务。
+
+    兼容后端可能返回的 `data.tasks`、`data.list`、`data.records`、`data[0]` 和单任务对象。
+    """
+    data = _unwrap_dyq_data(response_body)
+    candidates = None
+    if isinstance(data, list):
+        candidates = data
+    elif isinstance(data, dict):
+        for key in ('tasks', 'list', 'records'):
+            value = data.get(key)
+            if isinstance(value, list):
+                candidates = value
+                break
+        if candidates is None and any(k in data for k in ('taskUuid', 'uuid', 'id')):
+            candidates = [data]
+    if not candidates:
+        raise ValueError('DYQ pending-tasks 响应中没有待执行任务')
+    first = candidates[0]
+    if not isinstance(first, dict):
+        raise ValueError('DYQ pending-tasks 第一条任务不是对象')
+    return first
+
