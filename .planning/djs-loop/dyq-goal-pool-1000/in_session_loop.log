+
+function resolveSearchResultIntentScore(text: string, keyword: string, likeText?: string): number {
+  let score = 0.45;
+  if (keyword && text.includes(keyword)) score += 0.15;
+  for (const keywordHit of ['数字人直播', '直播间搭建', '获客', '报价', '私域转化']) {
+    if (text.includes(keywordHit)) score += 0.08;
+  }
+  const likeCount = Number.parseInt((likeText ?? '0').replace(/[^0-9]/g, ''), 10);
+  if (Number.isFinite(likeCount) && likeCount >= 50) score += 0.06;
+  return Math.min(Number(score.toFixed(2)), 0.95);
+}
+
+function searchResultToLiveRoomLead(
+  extraction: XiaohongshuSearchReadOnlyExtraction,
+  index: number,
+  options: XiaohongshuLiveLeadDraftOptions,
+): LiveRoomLeadInput | null {
+  const note = extraction.results[index];
+  const observedText = [note.title, note.author, note.like ? `互动数 ${note.like}` : undefined]
+    .filter(Boolean)
+    .join('｜');
+  if (!observedText.trim()) return null;
+
+  const intentTags = resolveXiaohongshuIntentTags(observedText, [extraction.keyword, ...(options.keywordTags ?? [])]);
+  const intentScore = resolveSearchResultIntentScore(observedText, extraction.keyword, note.like);
+  if (intentScore < HIGH_INTENT_THRESHOLD) return null;
+
+  return {
+    sourcePlatform: 'xiaohongshu',
+    sourceContentId: `search-${note.index ?? index}`,
+    sourceUrl: note.href,
+    anchorName: note.title || note.author || `搜索结果 ${index + 1}`,
+    observedText: [`搜索关键词：${extraction.keyword}`, observedText].join('｜'),
+    intentTags,
+    intentScore,
+    suggestedComment: options.suggestedComment ?? '我整理过一份数字人直播间搭建和获客清单，可以人工确认后再回复。',
+    collectedAt: options.collectedAt ?? extraction.capturedAt,
+  };
 }
 
