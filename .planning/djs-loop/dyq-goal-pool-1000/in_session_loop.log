+export function enqueueXiaohongshuLiveLeadDetailsToConfirmationQueue(
+  extractions: XiaohongshuDetailEndToEndExtraction[],
+  queue: InMemoryHumanConfirmationQueue,
+  options: XiaohongshuLiveLeadDraftOptions = {},
+): HumanConfirmationDraftInput[] {
+  const accepted: HumanConfirmationDraftInput[] = [];
+
+  for (const extraction of extractions) {
+    if (extraction.requiresHuman || !extraction.detail) {
+      continue;
+    }
+    const draft = buildLiveRoomLeadDraftFromXiaohongshuDetail(extraction, options);
+    queue.enqueueDraft(draft);
+    accepted.push(draft);
+  }
+
+  return accepted;
+}
