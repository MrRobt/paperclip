+def submit_wechat_event_report(
+    base_url: str,
+    token: str,
+    task_id: str,
+    listener_event: Dict[str, Any],
+) -> Dict[str, Any]:
+    """把微信监听事件按设备签名规则回传 DYQ 云端。
+
+    只复用 result 通道提交事件结果，不触发真实微信发送或自动回复。
+    """
+    event_report = create_wechat_event_report_result(task_id, listener_event)
+    signed_request = build_signed_result_request(base_url, task_id, token, event_report)
+    submit_response = _http_json_request(
+        signed_request['method'],
+        signed_request['url'],
+        headers=signed_request['headers'],
+        body=signed_request['body'],
+    )
+    body = submit_response.get('body', {})
+    if submit_response.get('httpStatus') != 200 or (isinstance(body, dict) and body.get('code') not in (None, 0, '0')):
+        raise RuntimeError(f'DYQ 事件上报回传失败: {submit_response}')
+    return {
+        'taskId': task_id,
+        'eventReport': event_report,
+        'submitResponse': submit_response,
+    }
