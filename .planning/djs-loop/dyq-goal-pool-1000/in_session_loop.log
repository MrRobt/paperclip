 export interface ClawMainlineOverviewResp {
   updatedAt: string
   items: ClawMainlineOverviewItem[]
+}
+
+/** PokeClaw 端侧证据包 operator-status.json 的最小消费契约 */
+export interface PokeClawOperatorStatus {
+  status: 'PASS' | 'WARN' | 'FAIL' | string
+  goal?: string
+  deviceStatus?: 'online' | 'no_online_device' | string
+  adbOnlineCount?: number
+  cloudLoopContract?: 'PASS' | 'WARN' | 'FAIL' | string
+  operatorDashboardHtml?: string
+  nextOperatorAction?: string
+}
+
+const basename = (value?: string) => {
+  if (!value) return ''
+  const parts = value.split(/[\\/]/).filter(Boolean)
+  return parts[parts.length - 1] || value
+}
+
+/** 把 PokeClaw 证据包状态归一化为 Claw 首页运行态检查项 */
+export const mapPokeClawOperatorStatusToRuntimeChecks = (
+  status: PokeClawOperatorStatus
+): ClawMainlineOverviewItem['runtimeChecks'] => {
+  const onlineCount = Number(status.adbOnlineCount || 0)
+  const contractPassed = status.cloudLoopContract === 'PASS'
+  const dashboard = basename(status.operatorDashboardHtml)
+
+  return [
+    { label: '设备在线', value: `${onlineCount} 台`, status: onlineCount > 0 ? 'normal' : 'warning' },
+    { label: '端侧契约', value: contractPassed ? '通过' : '待处理', status: contractPassed ? 'normal' : 'warning' },
+    { label: '状态来源', value: 'operator-status.json', status: status.status === 'PASS' ? 'normal' : 'warning' },
+    ...(dashboard ? [{ label: '可浏览看板', value: dashboard, status: 'normal' as const }] : [])
+  ]
 }
 
