+    author: '第26轮S1线索',
+    commentsCount: 3,
+    comments: [
+      { text: '多少钱可以做一套数字人直播间？' },
+      { text: '需要直播间搭建和获客方案。' },
+      { text: '可以私信发一下报价吗？' },
+    ],
+  },
+};
+const draft = buildLiveRoomLeadDraftFromXiaohongshuDetail(extraction, {
+  keywordTags: ['数字人直播', '直播间搭建', '报价'],
+  suggestedComment: '我整理过数字人直播间搭建、获客和报价清单，可由人工确认后再回复。',
+  collectedAt: '2026-06-06T23:16:00+08:00',
+});
