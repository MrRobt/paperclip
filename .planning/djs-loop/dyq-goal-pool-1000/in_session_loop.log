+#!/usr/bin/env python3
+"""WeFlow DYQ 任务领取后的安全草稿回执契约测试。"""
+
+import importlib.util
+import pathlib
+import unittest
+
+
+SCRIPT_PATH = pathlib.Path(__file__).with_name("weflow-dyq-device-register.py")
+spec = importlib.util.spec_from_file_location("weflow_dyq_device_register", SCRIPT_PATH)
+module = importlib.util.module_from_spec(spec)
+assert spec.loader is not None
+spec.loader.exec_module(module)
+
+
+class WeFlowDyqSafeDraftTest(unittest.TestCase):
+    def test_微信文本任务只生成草稿不自动发送(self):
+        pending_task = {
+            "taskUuid": "task-001",
+            "taskType": "wechat.message.prepare_text",
+            "payload": {
+                "sessionName": "文件传输助手",
+                "text": "你好，这是一条需要人工确认的回复",
+                "requestId": "req-001",
+            },
+        }
+
+        result = module.create_safe_draft_result(pending_task)
+
+        self.assertTrue(result["success"])
+        self.assertEqual(result["status"], "prepared")
+        self.assertEqual(result["commandType"], "wechat.message.prepare_text")
+        self.assertEqual(result["sessionName"], "文件传输助手")
+        self.assertEqual(result["draft"]["text"], "你好，这是一条需要人工确认的回复")
+        self.assertTrue(result["evidence"]["manualTakeoverRequired"])
+        self.assertFalse(result["evidence"]["sendActionExecuted"])
+        self.assertEqual(result["safetyDecision"], "HUMAN_CONFIRM_REQUIRED")
+
+    def test_真实发送类任务降级为人工确认草稿(self):
+        pending_task = {
+            "uuid": "task-002",
+            "type": "wechat.message.send_text",
+            "data": {
+                "target": "张三",
+                "content": "禁止自动发送，必须人工确认",
+            },
+        }
+
+        result = module.create_safe_draft_result(pending_task)
+
+        self.assertTrue(result["success"])
+        self.assertEqual(result["status"], "prepared")
+        self.assertEqual(result["commandType"], "wechat.message.send_text")
+        self.assertEqual(result["sessionName"], "张三")
+        self.assertEqual(result["draft"]["text"], "禁止自动发送，必须人工确认")
+        self.assertTrue(result["evidence"]["manualTakeoverRequired"])
+        self.assertFalse(result["evidence"]["sendActionExecuted"])
+        self.assertIn("禁止自动发送", result["retryPolicy"])
+
+
+if __name__ == "__main__":
+    unittest.main()
