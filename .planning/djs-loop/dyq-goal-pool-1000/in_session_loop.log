+def _parse_admin_command_fallback(command: Any) -> Dict[str, Any]:
+    """把管理后台 execute 的通用 command 文本尽量解析为安全草稿字段。"""
+    if not isinstance(command, str) or not command.strip():
+        return {}
+    parts = command.strip().split()
+    parsed: Dict[str, Any] = {'rawCommand': command.strip()}
+    if parts and parts[0].startswith('wechat.message.'):
+        parsed['taskType'] = parts[0]
+    for key in ('sessionName', 'target', 'contactName', 'text', 'content', 'message'):
+        marker = f'{key}='
+        if marker in command:
+            value = command.split(marker, 1)[1]
+            for stop_key in (' sessionName=', ' target=', ' contactName=', ' text=', ' content=', ' message='):
+                if stop_key.strip().startswith(key + '='):
+                    continue
+                if stop_key in value:
+                    value = value.split(stop_key, 1)[0]
+            parsed[key] = value.strip()
+    if not any(parsed.get(k) for k in ('text', 'content', 'message')):
+        parsed['text'] = command.strip()
+    return parsed
+
