+def _unwrap_dyq_data(response_body: Dict[str, Any]) -> Any:
+    """兼容DYQ统一响应结构，取出真正的任务数据。"""
+    if not isinstance(response_body, dict):
+        return response_body
+    if 'data' in response_body:
+        return response_body.get('data')
+    return response_body
