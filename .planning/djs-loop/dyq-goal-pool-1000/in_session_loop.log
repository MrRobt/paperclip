 function normalizeTaskPart(value: string): string {
   return value.trim().replace(/\s+/g, '-');
+}
+
+function resolveXiaohongshuIntentTags(detailText: string, keywordTags: string[]): string[] {
+  const tags = new Set(keywordTags.filter(Boolean));
+  for (const keyword of ['数字人直播', '直播间搭建', '私域转化', '获客', '报价']) {
+    if (detailText.includes(keyword)) tags.add(keyword);
+  }
+  return [...tags];
+}
+
+function resolveXiaohongshuIntentScore(detailText: string, commentsCount: number, tags: string[]): number {
+  let score = 0.55;
+  if (tags.includes('数字人直播')) score += 0.12;
+  if (tags.includes('直播间搭建')) score += 0.1;
+  if (tags.includes('报价') || detailText.includes('多少钱') || detailText.includes('费用')) score += 0.08;
+  if (commentsCount >= 2) score += 0.08;
+  return Math.min(Number(score.toFixed(2)), 0.95);
 }
 
