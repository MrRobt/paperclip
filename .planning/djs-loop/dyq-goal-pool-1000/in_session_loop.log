+import type { AutomationRiskLevel } from '../core/types.ts';
+import type { HumanConfirmationDraftInput } from '../console/human-confirmation-queue.ts';
+import { InMemoryHumanConfirmationQueue } from '../console/human-confirmation-queue.ts';
+
+export interface LiveRoomLeadInput {
+  sourcePlatform: string;
+  sourceContentId: string;
+  sourceUrl?: string;
+  anchorName: string;
+  observedText: string;
+  intentTags: string[];
+  intentScore: number;
+  suggestedComment: string;
+  collectedAt: string;
+}
+
+export interface LiveRoomLeadQueueResult {
+  accepted: HumanConfirmationDraftInput[];
+  rejected: { sourceContentId: string; reason: string }[];
+}
+
+const HIGH_INTENT_THRESHOLD = 0.7;
+const S1_BUSINESS_SCENARIO = 'S1直播间截流';
+const SAFETY_BOUNDARY = '仅生成评论草稿并进入人工确认队列，不自动评论、不私信、不关注、不点赞、不绕过登录或风控';
+
+function resolveDraftRiskLevel(intentScore: number): AutomationRiskLevel {
+  return intentScore >= 0.85 ? 'high' : 'medium';
+}
+
+function normalizeTaskPart(value: string): string {
+  return value.trim().replace(/\s+/g, '-');
+}
+
+export function buildLiveRoomLeadConfirmationDraft(input: LiveRoomLeadInput): HumanConfirmationDraftInput {
+  if (input.intentScore < HIGH_INTENT_THRESHOLD) {
+    throw new Error('直播间线索意向分低于 0.7，禁止进入人工确认队列以避免刷屏骚扰');
+  }
+
+  return {
+    taskId: `s1-live-lead-${normalizeTaskPart(input.sourcePlatform)}-${normalizeTaskPart(input.sourceContentId)}`,
+    platform: input.sourcePlatform,
+    type: 'comment',
+    businessScenario: S1_BUSINESS_SCENARIO,
+    target: input.sourceUrl ?? input.sourceContentId,
+    content: input.suggestedComment,
+    riskLevel: resolveDraftRiskLevel(input.intentScore),
+    reviewNote: [
+      'S1 直播间/热点线索截流：只读观察结果已转为人工确认评论草稿。',
+      `锚点：${input.anchorName}`,
+      `意向：${input.intentTags.join('、')}｜分数 ${input.intentScore}`,
+      `观察：${input.observedText}`,
+      `安全边界：${SAFETY_BOUNDARY}`,
+    ].join(' '),
+  };
+}
+
+export function enqueueLiveRoomLeadsToConfirmationQueue(
+  inputs: LiveRoomLeadInput[],
+  queue: InMemoryHumanConfirmationQueue,
+): HumanConfirmationDraftInput[] {
+  const accepted: HumanConfirmationDraftInput[] = [];
+
+  for (const input of inputs) {
+    if (input.intentScore < HIGH_INTENT_THRESHOLD) {
+      continue;
+    }
+    const draft = buildLiveRoomLeadConfirmationDraft(input);
+    queue.enqueueDraft(draft);
+    accepted.push(draft);
+  }
+
+  return accepted;
+}
