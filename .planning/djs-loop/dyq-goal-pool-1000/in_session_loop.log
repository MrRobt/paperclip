+export function buildLiveRoomLeadDraftFromXiaohongshuDetail(
+  extraction: XiaohongshuDetailEndToEndExtraction,
+  options: XiaohongshuLiveLeadDraftOptions = {},
+): HumanConfirmationDraftInput {
+  if (extraction.requiresHuman || !extraction.detail) {
+    throw new Error('小红书只读详情需要人工接管，禁止生成自动化评论草稿');
+  }
+  const detail = extraction.detail;
+  const comments = detail.comments.map((comment) => comment.text ?? '').filter(Boolean);
+  const observedText = [detail.title, detail.desc, ...comments].filter(Boolean).join('｜');
+  const intentTags = resolveXiaohongshuIntentTags(observedText, options.keywordTags ?? []);
+  const intentScore = resolveXiaohongshuIntentScore(observedText, comments.length, intentTags);
+
+  return buildLiveRoomLeadConfirmationDraft({
+    sourcePlatform: 'xiaohongshu',
+    sourceContentId: normalizeTaskPart(detail.title || extraction.url || extraction.tabId),
+    sourceUrl: extraction.url,
+    anchorName: detail.title || detail.author || '小红书只读详情',
+    observedText,
+    intentTags,
+    intentScore,
+    suggestedComment: options.suggestedComment ?? '我整理过一份数字人直播间搭建和获客清单，可以人工确认后再回复。',
+    collectedAt: options.collectedAt ?? new Date().toISOString(),
